# ========================================================
# OPTION 1: GOOGLE SHEETS DEPLOYMENT (Recommended & Easiest)
# ========================================================
# Deploy the Apps Script from google-sheets-script.js as a Web App (Access: Anyone)
# and paste your Web App URL here:
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/AKfycb.../exec

# ========================================================
# OPTION 2: SUPABASE DEPLOYMENT CONFIGURATION
# ========================================================
# Replace these with your project credentials from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key
